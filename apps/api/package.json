{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "concurrently -n tsc,node -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -b && tsc -p tsconfig.spec.json --noEmit",
    "auth:generate": "STRIPE_SECRET_KEY=sk_test_schema_generation STRIPE_WEBHOOK_SECRET=whsec_schema_generation npx --yes auth@latest generate --config src/auth/auth.config.ts --output ../../packages/db/src/schema/auth.schema.ts --yes && node ../../scripts/postprocess-auth-schema.mjs ../../packages/db/src/schema/auth.schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "stripe:setup": "node scripts/stripe-setup.mjs"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/db": "workspace:*",
    "@better-auth/stripe": "1.7.5",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
