# pnpm >= 10.16 introduced `minimumReleaseAge`, which delays resolution of freshly
# published versions. Inside a Docker build that makes `--frozen-lockfile` fail with
# "lockfile is not up to date" even though nothing changed. Disable it explicitly so
# the lockfile resolves identically on the host and in CI/Docker.
minimum-release-age=0

# Angular and NestJS both ship loose peer ranges; failing the install on them is noise.
strict-peer-dependencies=false
auto-install-peers=true

# Keep the store layout predictable for the Docker cache mount.
package-import-method=hardlink
