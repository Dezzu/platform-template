# Specchio delle variabili usate da compose.yml. Su Portainer questi valori si mettono
# nella sezione "Environment variables" dello stack, non in un file.

# ── Reti esterne ──────────────────────────────────────────────────────────────
# Vanno create PRIMA del deploy (vedi README) e condivise con gli altri stack:
# il tuo Grafana deve stare su OBSERVABILITY_NETWORK per interrogare Tempo e
# Prometheus, e le applicazioni per raggiungere Alloy.
OBSERVABILITY_NETWORK=observability
POSTGRES_NETWORK=postgres_network

# ── Porte OTLP pubblicate sull'host ───────────────────────────────────────────
# Servono solo se le applicazioni girano su una rete diversa. Se stanno su
# OBSERVABILITY_NETWORK, preferisci http://alloy:4318 e togli la sezione ports.
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317

# ── Prometheus ────────────────────────────────────────────────────────────────
# Quanto tieni le metriche. È il parametro che decide il disco.
PROMETHEUS_RETENTION=30d

# ── Profilo postgres-metrics ──────────────────────────────────────────────────
# Un ruolo in SOLA LETTURA, non quello dell'applicazione: l'exporter legge le
# pg_stat_* di tutti i database dell'istanza condivisa.
POSTGRES_EXPORTER_DSN=

# ── Profilo errors (GlitchTip) ────────────────────────────────────────────────
# Database dedicato sull'istanza condivisa, non quello dell'applicazione.
GLITCHTIP_DATABASE_URL=
# openssl rand -base64 48
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=glitchtip@localhost
