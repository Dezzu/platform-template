{
  "name": "saas-template",
  "version": "0.0.0",
  "private": true,
  "description": "Template SaaS: Angular 22 + NestJS 12 + Drizzle + Better Auth + Stripe",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.4.0"
  },
  "scripts": {
    "verify": "pnpm lint && pnpm env:check && pnpm i18n:check && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm ng test libs && pnpm ng test app",
    "build": "pnpm -r --if-present build",
    "env:check": "node scripts/check-env-example.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:app": "ng serve app",
    "dev:web": "ng serve web",
    "start:api": "pnpm --filter @app/api build && pnpm --filter @app/api start",
    "build:app": "ng build app",
    "build:web": "ng build web",
    "ng": "ng",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate",
    "db:seed": "pnpm --filter @app/db seed",
    "db:studio": "pnpm --filter @app/db studio",
    "auth:generate": "pnpm --filter @app/api auth:generate",
    "stripe:setup": "pnpm --filter @app/api stripe:setup",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "stripe:test-clock": "pnpm --filter @app/api stripe:test-clock",
    "docker:dev": "docker compose -f docker/compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker/compose.dev.yml down",
    "docker:dev:reset": "docker compose -f docker/compose.dev.yml down -v"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.5",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/ssr": "^22.1.8",
    "@better-auth/stripe": "1.7.5",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@spartan-ng/brain": "^1.4.1",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.2",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  }
}
