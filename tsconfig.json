{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@spartan-ng/helm/*": ["./libs/primitives/*/src/index.ts", "./libs/primitives/*"],
      "@app/ui/*": ["./libs/ui/src/*"],
      "@app/admin/*": ["./libs/admin/src/*"],
      "@app/core": ["./libs/core/src/index.ts"],
      "@app/core/*": ["./libs/core/src/*"],
      "@app/i18n": ["./libs/i18n/src/index.ts"],
      "@app/contracts": ["./packages/contracts/src/index.ts"],
      "@app/contracts/permissions": ["./packages/contracts/src/common/permissions.ts"],
      "@app/contracts/app-mode": ["./packages/contracts/src/common/app-mode.ts"],
      "@app/contracts/consent": ["./packages/contracts/src/common/consent.ts"],
      "@app/contracts/flags": ["./packages/contracts/src/common/flags.ts"],
      "@app/contracts/errors": ["./packages/contracts/src/common/error-codes.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "typeCheckHostBindings": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/web/tsconfig.app.json"
    },
    {
      "path": "./apps/app/tsconfig.app.json"
    }
  ]
}
