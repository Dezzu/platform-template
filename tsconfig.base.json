{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "importHelpers": true,
    "noEmitOnError": true,
    "paths": {
      "@spartan-ng/helm/*": ["./libs/primitives/*/src/index.ts", "./libs/primitives/*"],
      "@spartan-ng/helm/card": ["./libs/primitives/card/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/primitives/utils/src/index.ts"],
      "@spartan-ng/helm/field": ["./libs/primitives/field/src/index.ts"],
      "@spartan-ng/helm/label": ["./libs/primitives/label/src/index.ts"],
      "@spartan-ng/helm/separator": ["./libs/primitives/separator/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/primitives/input/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./libs/primitives/input-group/src/index.ts"],
      "@spartan-ng/helm/button": ["./libs/primitives/button/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./libs/primitives/textarea/src/index.ts"],
      "@spartan-ng/helm/select": ["./libs/primitives/select/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./libs/primitives/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/toggle-group": ["./libs/primitives/toggle-group/src/index.ts"],
      "@spartan-ng/helm/toggle": ["./libs/primitives/toggle/src/index.ts"],
      "@spartan-ng/helm/table": ["./libs/primitives/table/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./libs/primitives/spinner/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./libs/primitives/skeleton/src/index.ts"],
      "@spartan-ng/helm/pagination": ["./libs/primitives/pagination/src/index.ts"],
      "@spartan-ng/helm/empty": ["./libs/primitives/empty/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./libs/primitives/avatar/src/index.ts"],
      "@spartan-ng/helm/badge": ["./libs/primitives/badge/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./libs/primitives/sheet/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./libs/primitives/tooltip/src/index.ts"],
      "@spartan-ng/helm/alert-dialog": ["./libs/primitives/alert-dialog/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./libs/primitives/checkbox/src/index.ts"],
      "@spartan-ng/helm/switch": ["./libs/primitives/switch/src/index.ts"],
      "@spartan-ng/helm/scroll-area": ["./libs/primitives/scroll-area/src/index.ts"],
      "@spartan-ng/helm/alert": ["./libs/primitives/alert/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./libs/primitives/dialog/src/index.ts"],
      "@spartan-ng/helm/autocomplete": ["./libs/primitives/autocomplete/src/index.ts"],
      "@spartan-ng/helm/popover": ["./libs/primitives/popover/src/index.ts"],
      "@spartan-ng/helm/date-picker": ["./libs/primitives/date-picker/src/index.ts"],
      "@spartan-ng/helm/calendar": ["./libs/primitives/calendar/src/index.ts"],
      "@spartan-ng/helm/command": ["./libs/primitives/command/src/index.ts"],
      "@spartan-ng/helm/sidebar": ["./libs/primitives/sidebar/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage", ".angular"]
}
