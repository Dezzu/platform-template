# This file mirrors apps/api/src/config/env.schema.ts.
# If you add a variable there, add it here too — CI treats the pair as a contract.

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=saas-template
APP_PORT=3000
APP_URL=http://localhost:3000
WEB_URL=http://localhost:4200
DASHBOARD_URL=http://localhost:4300
LOG_LEVEL=debug
DEFAULT_LOCALE=it
SUPPORTED_LOCALES=it,en

# ─── Database ──────────────────────────────────────────────────────────────────
# Host port 5433 (docker/compose.dev.yml) to avoid clashing with a local Postgres.
DATABASE_URL=postgres://app:app@localhost:5433/app
# Keep this conservative in production: the Postgres instance is shared with other stacks.
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ─── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Queue (BullMQ) ────────────────────────────────────────────────────────────
# Key prefix for every BullMQ structure. Empty falls back to APP_NAME — which matters
# because the production Valkey is shared: two stacks on the same prefix would eat
# each other's jobs.
QUEUE_PREFIX=
# Whether this process also CONSUMES jobs. Keep true in development; set false on the
# API containers once a dedicated worker container exists.
QUEUE_RUN_WORKERS=true
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=5

# ─── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (minimum 32 characters, enforced)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Exact origins only. A wildcard is rejected at startup.
AUTH_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:4300
# Signing in requires clicking the emailed link first. Off locally so a fresh clone
# works immediately; the config validation REFUSES to start in production with it off.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# Empty locally; set to .example.com in production.
COOKIE_DOMAIN=
# Social login is simply disabled while these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Stripe Tax collects ONLY where the account has an active registration. Enabled
# without one it raises no error and collects nothing, while you believe VAT is
# handled — so it stays off until Tax Settings has a head office address and each
# jurisdiction shows as "Collecting". See https://docs.stripe.com/tax/set-up
STRIPE_AUTOMATIC_TAX=false
# Collecting the customer's VAT id is safe regardless: it is what makes B2B reverse
# charge possible once registrations exist.
STRIPE_TAX_ID_COLLECTION=true

# ─── Mail ──────────────────────────────────────────────────────────────────────
# smtp -> local Mailpit; ses -> AWS. Production must use ses.
MAIL_DRIVER=smtp
MAIL_FROM="SaaS Template <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Empty for Mailpit, which accepts any credentials.
SMTP_USER=
SMTP_PASSWORD=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SES configuration set — the only way bounces and complaints become reportable.
# Set it before the first production send; the history before it is unrecoverable.
MAIL_SES_CONFIGURATION_SET=

# ─── Storage (MinIO / S3) ──────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Fixed, not a preference: presigned signatures are region-bound and the shared
# production MinIO is pinned to eu-west-1.
S3_REGION=eu-west-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# The endpoint the BROWSER must reach. Presigned signatures cover the Host header, so
# signing against an internal name (http://minio:9000) yields URLs that fail with a
# signature mismatch in the browser. Empty means "same as S3_ENDPOINT".
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=true
# Every GET/HEAD goes through a presigned URL — header-signed SigV4 breaks behind
# Cloudflare. See CLAUDE.md.
S3_PRESIGN_EXPIRES=900
# Checked before a URL is issued, and again against the real object on commit.
STORAGE_MAX_UPLOAD_BYTES=26214400
# Empty allows any content type, which is rarely what you want in production.
STORAGE_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/csv,text/plain
# How long an abandoned upload survives before the janitor job removes it.
STORAGE_PENDING_TTL_HOURS=24

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=saas-template-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── GDPR ──────────────────────────────────────────────────────────────────────
GDPR_DELETION_GRACE_DAYS=30
GDPR_EXPORT_TTL_HOURS=48

# ─── Roles ─────────────────────────────────────────────────────────────────────
# Platform role for every new account. 'user' has no platform permissions at all;
# promoting to 'admin' or 'superadmin' must be an explicit act.
AUTH_DEFAULT_ROLE=user
# Role of whoever creates an organization, and role for anyone who joins one later.
ORG_CREATOR_ROLE=owner
ORG_DEFAULT_ROLE=member

# What a subscription hangs off: 'organization' (the tenant pays — B2B default) or
# 'user' (the person pays — for a B2C portal where organizations exist only to keep
# data isolated and are never shown). Enforced server-side, not just in the UI.
BILLING_SCOPE=organization
