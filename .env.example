# ─── Database ──────────────────────────────────────────────────────────────────
# Local dev uses host port 5433 (docker/compose.dev.yml) to avoid clashing with an
# already-running Postgres on the default port.
DATABASE_URL=postgres://app:app@localhost:5433/app
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ─── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Storage (MinIO / S3) ──────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Mandatory and must not change: presigned signatures are region-bound and the
# shared production MinIO is pinned to eu-west-1.
S3_REGION=eu-west-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Mail ──────────────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=saas-template
APP_PORT=3000

# ─── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:4300
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# Leave empty locally; set to .example.com in production.
COOKIE_DOMAIN=

# Google OAuth — social login is simply disabled when these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
