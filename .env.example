# ─── Database ──────────────────────────────────────────────────────────────────
# Local dev uses host port 5433 (docker/compose.dev.yml) to avoid clashing with an
# already-running Postgres on the default port.
DATABASE_URL=postgres://app:app@localhost:5433/app
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ─── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Storage (MinIO / S3) ──────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Mandatory and must not change: presigned signatures are region-bound and the
# shared production MinIO is pinned to eu-west-1.
S3_REGION=eu-west-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Mail ──────────────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
